[global]
   server role = standalone server
   workgroup = {{ samba_files_workgroup }}
   server string = {{ samba_files_server_string }}
   disable netbios = yes
   smb ports = 445
   server min protocol = SMB2_02
   server max protocol = SMB3
   map to guest = bad user
   guest account = nobody
   interfaces = lo {{ samba_files_interface }}
   bind interfaces only = yes
   hosts allow = {{ (samba_files_allowed_networks + ['127.0.0.1/32']) | join(' ') }}
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d
   unix extensions = no
   wide links = no

[{{ samba_files_share_name }}]
   comment = {{ samba_files_comment }}
   path = {{ samba_files_path }}
   browseable = yes
   read only = no
   guest ok = yes
   force user = {{ samba_files_force_user }}
   force group = {{ samba_files_force_group }}
   create mask = {{ samba_files_create_mask }}
   directory mask = {{ samba_files_directory_mask }}
