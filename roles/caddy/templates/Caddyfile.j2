# Managed by Ansible (role: caddy). Source: group_vars/vpn/vpn.yml
{% if caddy_acme_email | length > 0 %}
{
	email {{ caddy_acme_email }}
}

{% endif %}
{{ caddy_panel_domain }} {
	reverse_proxy 127.0.0.1:{{ xui_panel_port }}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
	}
}

{{ caddy_sub_domain }} {
	reverse_proxy 127.0.0.1:{{ xui_sub_port }}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
	}
}
