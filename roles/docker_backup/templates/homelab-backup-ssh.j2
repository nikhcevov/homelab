#!/bin/bash
set -euo pipefail
case "${SSH_ORIGINAL_COMMAND:-}" in
    '/usr/local/sbin/homelab-appdata-backup prepare') exec /usr/local/sbin/homelab-appdata-backup prepare ;;
    '/usr/local/sbin/homelab-appdata-backup resume') exec /usr/local/sbin/homelab-appdata-backup resume ;;
    rsync\ --server\ --sender\ *)
        # rrsync validates server arguments and confines paths to appdata.
        mountpoint -q {{ docker_backup_appdata | quote }}
        test "$(findmnt -n -o FSTYPE --target {{ docker_backup_appdata | quote }})" = ext4
        test "$(findmnt -n -o LABEL --target {{ docker_backup_appdata | quote }})" = {{ docker_backup_appdata_label | quote }}
        exec /usr/bin/rrsync -ro {{ docker_backup_appdata | quote }}
        ;;
    *) echo 'Only backup prepare/resume and confined read-only rsync are allowed' >&2; exit 64 ;;
esac
