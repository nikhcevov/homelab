# Managed by Ansible (role: ssh). Source: inventory/group_vars/<group>/ssh.yml (sshd_* variables; edge and workstation groups both use this role).
Port {{ sshd_port }}
PasswordAuthentication {{ sshd_password_authentication }}
PermitRootLogin {{ sshd_permit_root_login }}
PubkeyAuthentication {{ sshd_pubkey_authentication }}
{% if sshd_allow_users | length > 0 %}
AllowUsers {{ sshd_allow_users | join(' ') }}
{% endif %}
