#!/usr/bin/env bash
# Managed by Ansible (roles/kde_lock_immediate) — local edits will be overwritten.
#
# Runs right AFTER resume (it is the ExecStop of kde-lock-raise.service,
# which is pulled in by suspend.target and stopped when that target
# deactivates on wake). Simulates user activity so a locked KDE session
# raises the password prompt and starts fprintd: open the lid, touch the
# sensor, done.
#
# This replaces the old LockScreenUi.qml patch, which raised the prompt
# when the lock screen LOADED — i.e. on lid close, BEFORE sleep. fprintd
# then held the Goodix fingerprint reader open for the whole suspend,
# USB xHCI could never power-gate, the platform never entered S0ix and
# the battery drained overnight (s2idle at near-idle power).
set -u

# Give kscreenlocker a moment to come up after wake.
sleep 2

# Pick the active graphical user session (fall back to any user session
# on seat0 — a locked session can briefly report a non-active state).
session=""
for s in $(loginctl list-sessions --no-legend | awk '$4 == "seat0" { print $1 }'); do
  [ "$(loginctl show-session "$s" -p Class --value)" = "user" ] || continue
  if [ "$(loginctl show-session "$s" -p State --value)" = "active" ]; then
    session="$s"
    break
  fi
  [ -z "$session" ] && session="$s"
done
[ -n "$session" ] || exit 0

user="$(loginctl show-session "$session" -p Name --value)"
uid="$(id -u "$user")"

runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
  dbus-send --session --type=method_call --print-reply \
  --dest=org.freedesktop.ScreenSaver /ScreenSaver \
  org.freedesktop.ScreenSaver.SimulateUserActivity >/dev/null 2>&1 || true
