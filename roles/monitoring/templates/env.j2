# Managed by Ansible — edit group_vars/<group>/ and re-run the playbook.
NTFY_URL="{{ ntfy_url }}"
NTFY_TOPIC_CRITICAL="{{ ntfy_topic_critical }}"
NTFY_TOPIC_ALERTS="{{ ntfy_topic_alerts }}"
NTFY_TOPIC_INFO="{{ ntfy_topic_info }}"
HOST_PREFIX="{{ host_prefix }}"
CHECK_SERVICES="{{ check_services }}"
CHECK_CONTAINERS="{{ check_containers }}"
DISK_THRESHOLD="{{ disk_threshold }}"
DISK_MOUNTS="{{ disk_mounts }}"
HTTPS_ENDPOINTS="{{ https_endpoints }}"
CHECK_PORTS="{{ check_ports | default('') }}"
BACKUP_DIR="{{ backup_dir | default('') }}"
BACKUP_MAX_AGE_HOURS="{{ backup_max_age_hours | default(25) }}"
