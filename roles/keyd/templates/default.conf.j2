# Managed by Ansible (roles/keyd) — local edits will be overwritten.
#
# Caps Lock acts as Left Ctrl, and Left Ctrl acts as Hyper
# (Ctrl+Alt+Shift+Super) on every keyboard EXCEPT the devices excluded via
# keyd_excluded_ids (group_vars/workstations/keyd.yml).
# `hyper` is defined below as a custom modifier layer (C-M-A-S).

[ids]
*
{% for id in keyd_excluded_ids -%}
-{{ id }}
{% endfor %}

[main]
capslock = leftcontrol
leftcontrol = layer(hyper)

# Custom modifier layer: Left Ctrl held = C-M-A-S active. Every key emits
# the full C-M-A-S set, so LCtrl+<key> is a conflict-free combo for global
# shortcuts in KDE (kglobalshortcutsrc). Plain Ctrl is still available on
# Caps Lock (capslock = leftcontrol above). Not predefined by keyd — must
# be declared like this.
[hyper:C-M-A-S]
