# Managed by Ansible (roles/keyd) — local edits will be overwritten.
#
# Caps Lock acts as Hyper (Ctrl+Alt+Shift+Super) on every keyboard EXCEPT
# the devices excluded via keyd_excluded_ids
# (inventory/group_vars/workstations/keyd.yml).
# `hyper` is defined below as a custom modifier layer (C-M-A-S).

[ids]
*
{% for id in keyd_excluded_ids -%}
-{{ id }}
{% endfor %}

[main]
capslock = layer(hyper)

# Custom modifier layer: Caps Lock held = C-M-A-S active. Every key emits
# the full C-M-A-S set, so Caps+<key> is a conflict-free combo for global
# shortcuts in KDE (kglobalshortcutsrc). Left Ctrl is untouched, so plain
# Ctrl stays where it is. Not predefined by keyd — must be declared like
# this.
[hyper:C-M-A-S]
