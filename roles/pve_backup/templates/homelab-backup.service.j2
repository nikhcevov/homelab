[Unit]
Description=Collect PBS recovery archives and prove the current backup cycle
Wants=network-online.target
After=network-online.target pve-guests.service
OnFailure=homelab-backup-failure@%n.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/sbin/homelab-backup backup
TimeoutStartSec=infinity
TimeoutStopSec=600
KillMode=control-group
