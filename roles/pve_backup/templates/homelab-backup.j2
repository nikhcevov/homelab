#!/bin/bash
source /usr/local/lib/homelab-backup/common.sh
command=${1:-}
if [[ "$command" = failure ]]; then
    case "${2:-}" in
        homelab-backup.service) key=backup ;;
        homelab-backup-collect.service) key=collector ;;
        homelab-backup-freshness.service) key=freshness ;;
        *) exit 64 ;;
    esac
    notify "$key" fail "Backup systemd unit ${2} failed; inspect its journal"
    exit 0
fi
case "$command" in
    backup|freshness) ;;
    *) echo 'usage: homelab-backup {backup|freshness}' >&2; exit 64 ;;
esac
finish() {
    local rc=$?
    trap - EXIT HUP INT TERM
    if [[ "$rc" = 0 ]]; then
        notify "$command" ok "$command completed" || rc=1
    else
        notify "$command" fail "$command failed: ${FAILURE_REASON:-inspect backup journal}" || true
    fi
    exit "$rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
case "$command" in
backup)
    exec 9>/run/lock/homelab-backup.lock
    flock -w 3600 9
    # No legacy resume, guest stop, rsync of live appdata or ZFS snapshots.
    # An unresolved old transaction needs operator recovery, not marker removal.
    [[ ! -e "$STATE/guest-needs-resume" ]] || die 'Preserved guest recovery marker requires manual recovery before cutover'
    source /usr/local/sbin/homelab-backup-collect
    collect_sources
    recovery="$STATE/recovery"
    sqlite3 /var/lib/pve-cluster/config.db ".backup '$recovery/pmxcfs-config.db.tmp'"
    mv -- "$recovery/pmxcfs-config.db.tmp" "$recovery/pmxcfs-config.db"
    tar --acls --xattrs --numeric-owner -czf "$recovery/pve-config.tar.gz.tmp" \
        -C / etc/pve etc/network etc/hosts etc/hostname etc/fstab etc/ssh \
        etc/homelab-backup etc/systemd/system root/.ssh {{ pve_pbs_secret_path | regex_replace('^/', '') | quote }} \
        var/lib/homelab-backup/recovery/pmxcfs-config.db
    gzip -t "$recovery/pve-config.tar.gz.tmp"
    mv -- "$recovery/pve-config.tar.gz.tmp" "$recovery/pve-config.tar.gz"
    pct exec {{ pve_backup_pbs_vmid }} -- tar --acls --xattrs --numeric-owner -czf - \
        -C / etc/proxmox-backup >"$recovery/pbs-config.tar.gz.tmp"
    gzip -t "$recovery/pbs-config.tar.gz.tmp"
    mv -- "$recovery/pbs-config.tar.gz.tmp" "$recovery/pbs-config.tar.gz"
    /usr/local/lib/homelab-backup/pbs-file-backup backup
    /usr/local/lib/homelab-backup/pbs-file-backup complete-cycle
    ;;
freshness)
    /usr/local/lib/homelab-backup/pbs-file-backup freshness
    ;;
esac
