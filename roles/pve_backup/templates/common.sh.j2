#!/bin/bash
set -euo pipefail
umask 077
STATE=/var/lib/homelab-backup
COLLECTOR={{ pve_backup_collector | quote }}
SSH=(ssh -i /etc/homelab-backup/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/homelab-backup/known_hosts)
RSYNC_SSH="ssh -i /etc/homelab-backup/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/homelab-backup/known_hosts"
NTFY_URL={{ ntfy_url | quote }}
NTFY_ALERTS={{ ntfy_topic_alerts | quote }}
NTFY_INFO={{ ntfy_topic_info | quote }}
log() { printf '%s\n' "$*" >&2; logger -t homelab-backup -- "$*"; }
die() { FAILURE_REASON=$*; log "ERROR: $*"; exit 1; }
notify() {
    local key=$1 status=$2 message=$3 previous='' topic priority tag emoji event title body host
    [[ ! -f "$STATE/$key.state" ]] || previous=$(cat "$STATE/$key.state")
    [[ "$previous" != "$status" ]] || return 0
    host=$(hostname)
    if [[ "$status" = fail ]]; then
        topic=$NTFY_ALERTS
        priority=high
        tag=warning
        emoji=⚠️
        event="$key failed"
    else
        topic=$NTFY_INFO
        priority=default
        tag=white_check_mark
        emoji=✅
        event="$key recovered"
    fi
    if [[ -n "$previous" || "$status" = fail ]]; then
        title="$emoji Homelab · Backup · $event"
        body="**$message**

- **Host:** \`$host\`
- **Component:** \`Backup\`
- **State:** \`$event\`"
        # Leave the old status on notification failure, so the next attempt retries.
        curl --fail --silent --show-error --max-time 15 --retry 2 \
            -H "Title: $title" -H "Priority: $priority" \
            -H "Tags: $tag,backup" -H "Markdown: yes" \
            --data-binary "$body" "${NTFY_URL%/}/$topic" >/dev/null || { log 'ntfy delivery failed'; return 1; }
    fi
    printf '%s\n' "$status" >"$STATE/$key.state.tmp"
    mv -- "$STATE/$key.state.tmp" "$STATE/$key.state"
}
require_collector() {
    local path={{ pve_backup_collector | quote }} dataset={{ pve_backup_collector_dataset | quote }}
    mountpoint -q "$path" || die 'Collector dataset is not mounted'
    [[ "$(findmnt -n -o FSTYPE --mountpoint "$path")" = zfs ]] || die 'Collector is not ZFS'
    [[ "$(findmnt -n -o SOURCE --mountpoint "$path")" = "$dataset" ]] || die 'Wrong collector dataset'
    [[ ",$(findmnt -n -o OPTIONS --mountpoint "$path")," != *,ro,* ]] || die 'Collector is read-only'
    [[ "$(stat -c '%u:%g:%a' "$path")" = 0:0:700 ]] || die 'Collector must be root-owned and mode0700'
}
