#!/usr/bin/python3
"""Host-owned, fail-closed PBS lifecycle; never destroys a CT or datastore."""
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

CT = '{{ pve_pbs_id }}'
STORES = json.loads({{ (pve_pbs_datastores | to_json) | to_json }})
STORE = json.loads({{ (pve_pbs_datastore | to_json) | to_json }})
SECONDARY = json.loads({{ (pve_pbs_secondary_datastore | to_json) | to_json }})
SYNC_ID = {{ pve_pbs_sync_job | to_json }}
STORAGE = {{ pve_pbs_storage_id | to_json }}
USER = {{ pve_pbs_user | to_json }}
TOKEN = {{ pve_pbs_token | to_json }}
AUTH = USER + '!' + TOKEN
SECRET = Path({{ pve_pbs_secret_path | to_json }})
MARKER = 'homelab-managed-pbs/v1'
SCHEDULES = {{ 'True' if pve_pbs_schedules_enabled | bool else 'False' }}
TIMEZONE = {{ bootstrap_timezone | to_json }}
changed = False
if (len({entry['name'] for entry in STORES}) != len(STORES)
        or len({entry['host_path'] for entry in STORES}) != len(STORES)
        or len({entry['guest_path'] for entry in STORES}) != len(STORES)
        or len({entry['source'] for entry in STORES}) != len(STORES)
        or len({entry['mount_index'] for entry in STORES}) != len(STORES)):
    raise RuntimeError('Datastores must have independent names, paths, filesystems and bind slots')
for entry in STORES:
    if (not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_-]*', entry['name'])
            or type(entry.get('enabled')) is not bool
            or type(entry.get('mount_index')) is not int
            or not 0 <= entry['mount_index'] <= 255
            or not Path(entry['host_path']).is_relative_to(entry['mountpoint'])
            or entry['fstype'] not in ('zfs', 'xfs')):
        raise RuntimeError('Invalid datastore topology')
ACTIVE = [entry for entry in STORES if entry['enabled']]
if not isinstance(STORE, str) or STORE not in {entry['name'] for entry in ACTIVE}:
    raise RuntimeError('Selected backup datastore must be managed and enabled')
if not isinstance(SECONDARY, str) or (SECONDARY != '' and (SECONDARY == STORE or SECONDARY not in {entry['name'] for entry in ACTIVE})):
    raise RuntimeError('Secondary datastore must be distinct, managed and enabled')


def run(*args, check=True):
    result = subprocess.run([str(a) for a in args], text=True, capture_output=True)
    if check and result.returncode:
        # Never include subprocess output: it can contain newly generated secrets.
        raise RuntimeError('Command failed: ' + str(args[0]))
    return result


def mutate(*args):
    global changed
    result = run(*args)
    changed = True
    return result


def guest(*args, check=True):
    return run('pct', 'exec', CT, '--', *args, check=check)


def manager(*args):
    return guest('proxmox-backup-manager', *args)


def listing(*args):
    return json.loads(manager(*args, '--output-format', 'json').stdout)


def save_secret(value):
    # Temp file is private from creation; rename is atomic across interruptions.
    fd, name = tempfile.mkstemp(prefix='.pbs-token-', dir=SECRET.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, SECRET)
        os.chmod(SECRET, 0o600)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def bind_changes(text):
    """Validate every managed identity before planning any bind mutation."""
    if re.search(r'^\[PENDING\]', text, re.M):
        raise RuntimeError('Pending CT configuration requires manual reconciliation')
    # Snapshot sections are history, not the live container configuration.
    text = text.split('\n[', 1)[0]
    slots = {}
    managed = {entry['mount_index']: entry for entry in STORES}
    for match in re.finditer(r'^mp(\d+):\s*(.+)$', text, re.M):
        index = int(match.group(1))
        parts = match.group(2).split(',')
        if index in slots:
            raise RuntimeError('Duplicate datastore bind slot; inspect the CT configuration')
        slots[index] = parts
        entry = managed.get(index)
        if entry:
            expected = {entry['host_path'], 'mp=' + entry['guest_path'], 'backup=0'}
            if len(parts) != 3 or parts[0] != entry['host_path'] or set(parts) != expected:
                raise RuntimeError('Existing datastore bind mount differs; never replace or remove it automatically')
        elif any(parts[0] == store['host_path'] or 'mp=' + store['guest_path'] in parts
                 for store in STORES):
            raise RuntimeError('Managed datastore is bound in a foreign slot; inspect manually')
    additions = [entry for entry in ACTIVE if entry['mount_index'] not in slots]
    removals = [entry for entry in STORES if not entry['enabled'] and entry['mount_index'] in slots]
    return additions, removals


def validate_registered_datastores(stores):
    for entry in STORES:
        existing = next((row for row in stores if row['name'] == entry['name']), None)
        if existing and existing['path'] != entry['guest_path']:
            raise RuntimeError('Existing datastore points elsewhere; refusing to replace it')


def require_idle():
    if listing('task', 'list'):
        raise RuntimeError('PBS has active tasks; retry bind-mount reconciliation after they finish')


def retire_datastores():
    """Keep configuration/history, but remove every inactive scheduling input."""
    stores = listing('datastore', 'list')
    validate_registered_datastores(stores)
    inactive = {entry['name'] for entry in STORES if not entry['enabled']}
    for row in stores:
        if row['name'] in inactive:
            manager('datastore', 'update', row['name'],
                    '--maintenance-mode', 'type=offline',
                    '--delete', 'gc-schedule', '--delete', 'prune-schedule')
    for kind in ('verify-job', 'prune-job', 'sync-job'):
        for row in listing(kind, 'list'):
            retire = row.get('store') in inactive
            if kind == 'sync-job':
                retire = (retire or (not row.get('remote') and row.get('remote-store') in inactive)
                          or (not SECONDARY and row['id'] == SYNC_ID))
            if not retire:
                continue
            if kind == 'prune-job':
                manager(kind, 'update', row['id'], '--disable', 'true')
            elif row.get('schedule'):
                manager(kind, 'update', row['id'], '--delete', 'schedule')
    return stores


def reconcile_binds(configuration):
    additions, removals = bind_changes(configuration.read_text())
    if not additions and not removals:
        return
    if 'running' in run('pct', 'status', CT).stdout:
        if guest('test', '-x', '/usr/sbin/proxmox-backup-manager', check=False).returncode == 0:
            require_idle()
            retire_datastores()
            require_idle()
        mutate('pct', 'shutdown', CT, '--timeout', '60')
    # Edit only a stopped CT: no stale live bind or pending unmount may survive.
    # A stopped CT needs no inactive filesystem or guest command to retire binds.
    additions, removals = bind_changes(configuration.read_text())
    for entry in removals:
        mutate('pct', 'set', CT, '--delete', 'mp' + str(entry['mount_index']))
    for entry in additions:
        mutate('pct', 'set', CT, '--mp' + str(entry['mount_index']),
               entry['host_path'] + ',mp=' + entry['guest_path'] + ',backup=0')


def retire_pve_storages(storages):
    retired = []
    for entry in STORES:
        if entry['enabled']:
            continue
        storage_id = 'pbs-' + entry['name']
        row = next((row for row in storages if row['storage'] == storage_id), None)
        if not row:
            continue
        if (row['type'] != 'pbs' or row.get('server') != '{{ pve_pbs_address }}'
                or row.get('datastore') != entry['name']):
            raise RuntimeError('Inactive storage ID is used by another target; refusing to disable it')
        retired.append(storage_id)
    # Validate all identities before disabling even the first old storage.
    for storage_id in retired:
        mutate('pvesm', 'set', storage_id, '--disable', '1')
    if retired:
        jobs = json.loads(run('pvesh', 'get', '/cluster/backup', '--output-format', 'json').stdout)
        for row in jobs:
            if row.get('storage') in retired:
                mutate('pvesh', 'set', '/cluster/backup/' + row['id'], '--enabled', '0')


def main():
    global changed
    # Dataset creation belongs to corestorage. Never create an empty fallback here.
    run('/usr/local/sbin/homelab-pbs-mount-guard')
    # Both native schedulers use local civil time; bootstrap owns that authority.
    if run('timedatectl', 'show', '--property=Timezone', '--value').stdout.strip() != TIMEZONE:
        raise RuntimeError('Host timezone differs from bootstrap_timezone; reconcile bootstrap before PBS schedules')
    conf = Path('/etc/pve/lxc/' + CT + '.conf')
    if Path('/etc/pve/qemu-server/' + CT + '.conf').exists():
        raise RuntimeError('CT101 is occupied by a VM; refusing to overwrite it')
    if conf.exists():
        text = conf.read_text()
        if MARKER not in text or 'unprivileged: 1' not in text:
            raise RuntimeError('Refusing to adopt an unmarked or privileged CT101')
        if ('bridge={{ pve_pbs_private_bridge }}' not in text
                or 'ip={{ pve_pbs_address }}/29' not in text):
            raise RuntimeError('Existing CT101 private network differs; inspect manually')
        bind_changes(text)

    storages = json.loads(run('pvesh', 'get', '/storage', '--output-format', 'json').stdout)
    current = next((row for row in storages if row['storage'] == STORAGE), None)
    if current and (current['type'] != 'pbs' or current.get('server') != '{{ pve_pbs_address }}'
                    or current.get('datastore') != STORE):
        raise RuntimeError('Storage ID is already used by another target')
    retire_pve_storages(storages)

    # Only change ownership of genuinely empty active roots, never their contents.
    for entry in ACTIVE:
        host_path = Path(entry['host_path'])
        if host_path.is_symlink() or not host_path.is_dir() or (host_path / '.chunks').is_symlink():
            raise RuntimeError('Datastore directory is missing or redirected')
        entries = list(host_path.iterdir())
        if entries and not (host_path / '.chunks').is_dir():
            raise RuntimeError('Nonempty directory is not a PBS datastore; refusing adoption')
        if not entries and host_path.stat().st_uid != 100034:
            os.chown(host_path, 100034, 100034)
            os.chmod(host_path, 0o750)
            changed = True
        if host_path.stat().st_uid != 100034 or host_path.stat().st_gid != 100034:
            raise RuntimeError('Datastore must belong to UID/GID100034; no recursive chown is performed')

    # Host roles own datacenter enable/default policies; PBS never changes them.
    if all(run('systemctl', 'is-active', '--quiet', service, check=False).returncode
           for service in ('pve-firewall', 'proxmox-firewall')):
        mutate('systemctl', 'enable', '--now', 'pve-firewall')
    if conf.exists():
        reconcile_binds(conf)
    else:
        meminfo = dict(re.findall(r'^(\w+):\s+(\d+)', Path('/proc/meminfo').read_text(), re.M))
        if int(meminfo['MemAvailable']) < ({{ pve_pbs_memory }} + 1024) * 1024:
            raise RuntimeError('Insufficient available host RAM for PBS plus 1GiB host headroom; measure the full guest/ZFS budget first')
        mutate('pveam', 'update')
        available = run('pveam', 'available', '--section', 'system').stdout
        templates = re.findall(r'\b(debian-13-standard_[^\s]+_amd64\.tar\.(?:zst|gz|xz))\b', available)
        if not templates:
            raise RuntimeError('No official Debian13 standard template is available; update PVE first')
        # pveam downloads the official catalogue template and verifies its checksum.
        template = sorted(set(templates))[-1]
        mutate('pveam', 'download', '{{ pve_pbs_template_storage }}', template)
        mount_args = []
        for entry in ACTIVE:
            mount_args += ['--mp' + str(entry['mount_index']),
                           entry['host_path'] + ',mp=' + entry['guest_path'] + ',backup=0']
        mutate('pct', 'create', CT, '{{ pve_pbs_template_storage }}:vztmpl/' + template,
               '--hostname', '{{ pve_pbs_hostname }}', '--description', MARKER,
               '--unprivileged', '1', '--memory', '{{ pve_pbs_memory }}',
               '--cores', '{{ pve_pbs_cores }}', '--swap', '512',
               '--rootfs', '{{ pve_pbs_root_storage }}:{{ pve_pbs_root_size }}',
               '--net0', 'name=eth0,bridge={{ pve_pbs_lan_bridge }},ip=dhcp,firewall=1',
               '--net1', 'name=eth1,bridge={{ pve_pbs_private_bridge }},ip={{ pve_pbs_address }}/29,firewall=1',
               *mount_args,
               '--onboot', '1', '--startup', 'order=10', '--features', 'nesting=0')

    # Persist the same time authority in LXC configuration for subsequent boots.
    if not re.search(r'^timezone:\s*' + re.escape(TIMEZONE) + r'\s*$', conf.read_text(), re.M):
        mutate('pct', 'set', CT, '--timezone', TIMEZONE)

    # CT-local filtering only: no LAN API/SSH exposure, DHCP/outbound apt work.
    firewall = Path('/etc/pve/firewall/' + CT + '.fw')
    firewall_text = '''[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT

[RULES]
IN ACCEPT -i net1 -source {{ pve_pbs_host_address }}/32 -p tcp -dport 8007
IN ACCEPT -i net0 -p udp -sport 67 -dport 68
'''
    if not firewall.exists() or firewall.read_text() != firewall_text:
        firewall.write_text(firewall_text)
        changed = True
    run('/usr/local/sbin/homelab-pbs-mount-guard')
    if ('running' in run('pct', 'status', CT).stdout
            and any(guest('mountpoint', '-q', entry['guest_path'], check=False).returncode
                    for entry in ACTIVE)):
        if guest('test', '-x', '/usr/sbin/proxmox-backup-manager', check=False).returncode == 0:
            require_idle()
        mutate('pct', 'shutdown', CT, '--timeout', '60')
    if 'running' not in run('pct', 'status', CT).stdout:
        mutate('pct', 'start', CT)
    if guest('timedatectl', 'show', '--property=Timezone', '--value').stdout.strip() != TIMEZONE:
        guest('timedatectl', 'set-timezone', TIMEZONE)
        changed = True

    # Stop on wrong distro rather than installing PBS4 into an incompatible guest.
    if guest('sh', '-c', '. /etc/os-release; printf %s "$VERSION_CODENAME"').stdout != 'trixie':
        raise RuntimeError('PBS4 requires Debian13/trixie')
    if guest('test', '-x', '/usr/sbin/proxmox-backup-manager', check=False).returncode:
        guest('sh', '-ec', '''
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates wget
wget -q https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg -O /usr/share/keyrings/proxmox-archive-keyring.gpg
printf '%s\\n' 'deb [signed-by=/usr/share/keyrings/proxmox-archive-keyring.gpg] http://download.proxmox.com/debian/pbs trixie pbs-no-subscription' > /etc/apt/sources.list.d/pbs.list
apt-get update
apt-get install -y proxmox-backup-server
# No subscription is assumed; retain the signed no-subscription source above.
rm -f /etc/apt/sources.list.d/pbs-enterprise.list /etc/apt/sources.list.d/pbs-enterprise.sources
''')
        changed = True
    # All appliance administration is through pct/PBS; no guest SSH listener.
    guest('systemctl', 'mask', '--now', 'ssh.service', 'ssh.socket')
    if guest('id', '-u', 'backup').stdout.strip() != '34' or guest('id', '-g', 'backup').stdout.strip() != '34':
        raise RuntimeError('Unexpected backup UID/GID; do not change the datastore mapping blindly')
    # /run is volatile; recreate the proxy's writable directory on every boot.
    runtime_path = '/etc/tmpfiles.d/homelab-pbs.conf'
    runtime_rule = 'd /run/proxmox-backup 0755 backup backup -'
    if guest('cat', runtime_path, check=False).stdout != runtime_rule + '\n':
        guest('sh', '-ec', 'echo "$1" > "$2"; chmod 0644 "$2"',
              'sh', runtime_rule, runtime_path)
        changed = True
    runtime_before = guest('stat', '-c', '%u:%g %a', '/run/proxmox-backup', check=False)
    guest('systemd-tmpfiles', '--create', runtime_path)
    if runtime_before.stdout.strip() != '34:34 755':
        changed = True
    guest('systemctl', 'enable', '--now', 'proxmox-backup', 'proxmox-backup-proxy')

    stores = retire_datastores()
    for entry in ACTIVE:
        existing = next((row for row in stores if row['name'] == entry['name']), None)
        if not existing:
            reuse = (Path(entry['host_path']) / '.chunks').is_dir()
            manager('datastore', 'create', entry['name'], entry['guest_path'],
                    '--reuse-datastore', 'true' if reuse else 'false')
            changed = True
        manager('datastore', 'update', entry['name'], '--delete', 'maintenance-mode')
        if SCHEDULES and entry['maintenance']:
            manager('datastore', 'update', entry['name'], '--gc-schedule', '{{ pve_pbs_gc_schedule }}')
        else:
            manager('datastore', 'update', entry['name'], '--delete', 'gc-schedule')

    users = listing('user', 'list')
    if not any(row['userid'] == USER for row in users):
        manager('user', 'create', USER, '--comment', 'PVE VM backups, no interactive password')
        changed = True
    tokens = listing('user', 'list-tokens', USER)
    exists = any(row.get('tokenid') == AUTH for row in tokens)
    if SECRET.exists():
        os.chmod(SECRET, 0o600)
        credentials = json.loads(SECRET.read_text())
        if credentials['auth-id'] != AUTH or not exists:
            raise RuntimeError('Saved PBS token does not match server; explicit credential recovery required')
    else:
        if exists:
            raise RuntimeError('Token exists but secret is missing. Restore recovery secret or explicitly remove that token and rerun')
        # generate-token has a documented "Result: " prefix, unlike list JSON.
        output = manager('user', 'generate-token', USER, TOKEN).stdout
        prefix, separator, payload = output.partition('Result:')
        if prefix.strip() or not separator:
            raise RuntimeError('Unexpected PBS token response; secret output withheld')
        try:
            credentials = json.loads(payload)
        except json.JSONDecodeError:
            raise RuntimeError('Invalid PBS token JSON; secret output withheld') from None
        if (not isinstance(credentials, dict) or credentials.get('tokenid') != AUTH
                or not isinstance(credentials.get('value'), str) or not credentials['value']):
            raise RuntimeError('Unexpected PBS token credentials; secret output withheld')
        credentials['auth-id'] = AUTH
        save_secret(credentials)
        changed = True
    # Privilege separation needs user and token grants; pruning is server-owned.
    for entry in ACTIVE:
        for auth in (USER, AUTH):
            manager('acl', 'update', '/datastore/' + entry['name'], 'DatastoreBackup', '--auth-id', auth)
        enabled = SCHEDULES and entry['maintenance']
        suffix = '' if entry['name'] == 'tank' else '-' + entry['name']
        for kind, jobid, args in (
            ('verify-job', 'homelab-verify' + suffix,
             ['--store', entry['name'], '--outdated-after', '7']),
            ('prune-job', 'homelab-prune' + suffix,
             ['--store', entry['name'], '--schedule', '{{ pve_pbs_prune_schedule }}',
              '--keep-daily', '{{ pve_pbs_keep_daily }}', '--keep-weekly', '{{ pve_pbs_keep_weekly }}',
              '--keep-monthly', '{{ pve_pbs_keep_monthly }}',
              '--disable', 'false' if enabled else 'true']),
        ):
            jobs = listing(kind, 'list')
            action = 'update' if any(row['id'] == jobid for row in jobs) else 'create'
            if kind == 'verify-job':
                if enabled:
                    args += ['--schedule', '{{ pve_pbs_verify_schedule }}']
                elif action == 'update':
                    args += ['--delete', 'schedule']
            manager(kind, action, jobid, *args)

    # Only a configured secondary gets a local pull job. No sync in B-only mode.
    if SECONDARY:
        syncs = listing('sync-job', 'list')
        existing = next((row for row in syncs if row['id'] == SYNC_ID), None)
        if existing and (existing.get('remote') or existing.get('remote-store') != STORE
                         or existing.get('store') != SECONDARY
                         or existing.get('owner') != AUTH
                         or existing.get('sync-direction', 'pull') != 'pull'
                         or existing.get('ns') or existing.get('remote-ns')
                         or existing.get('remove-vanished', False)):
            raise RuntimeError('Existing replica job differs; never redirect it or propagate deletions')
        args = ['--delete', 'schedule'] if existing and existing.get('schedule') else []
        manager('sync-job', 'update' if existing else 'create', SYNC_ID,
                '--remote-store', STORE, '--store', SECONDARY, '--owner', AUTH,
                '--sync-direction', 'pull', '--remove-vanished', 'false', *args)

    # Pin the local PBS TLS certificate; never use insecure certificate bypass.
    cert = manager('cert', 'info').stdout
    match = re.search(r'(?:[0-9a-fA-F]{2}:){31}[0-9a-fA-F]{2}', cert)
    if not match:
        raise RuntimeError('Unable to obtain the local PBS certificate fingerprint')
    fingerprint = match.group(0)
    # Keep the secret out of argv and logs in PVE's root-only private directory.
    password_dir = Path('/etc/pve/priv/storage')
    password_dir.mkdir(exist_ok=True)
    password_file = password_dir / (STORAGE + '.pw')
    # on_add_hook deletes omitted passwords. Add disabled, then write/activate.
    if not current:
        run('pvesm', 'add', 'pbs', STORAGE,
            '--server', '{{ pve_pbs_address }}', '--datastore', STORE, '--username', AUTH,
            '--fingerprint', fingerprint, '--content', 'backup', '--disable', '1')
    fd = os.open(password_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as stream:
        stream.write(credentials['value'] + '\n')
    if password_file.stat().st_mode & 0o777 != 0o600:
        raise RuntimeError('Native PBS password file is not root-only')
    run('pvesm', 'set', STORAGE,
        '--username', AUTH, '--fingerprint', fingerprint,
        '--content', 'backup', '--disable', '0')
    status = json.loads(run('pvesh', 'get', '/nodes/localhost/storage/' + STORAGE + '/status',
                            '--output-format', 'json').stdout)
    if not status.get('active'):
        raise RuntimeError('Registered PBS storage is not active; inspect credentials and TLS pin')
    jobs = json.loads(run('pvesh', 'get', '/cluster/backup', '--output-format', 'json').stdout)
    jobid = 'homelab-vm100-pbs'
    job = next((row for row in jobs if row['id'] == jobid), None)
    endpoint = '/cluster/backup/' + jobid if job else '/cluster/backup'
    args = [] if job else ['--id', jobid]
    run('pvesh', 'set' if job else 'create', endpoint, *args,
        '--vmid', '{{ pve_pbs_backup_vm }}', '--storage', STORAGE, '--schedule', '{{ pve_pbs_backup_schedule }}',
        '--mode', '{{ pve_pbs_backup_mode }}', '--enabled', '1' if SCHEDULES else '0',
        '--repeat-missed', '0', '--prune-backups', 'keep-all=1',
        '--notes-template', '{{ '{{guestname}}' }}')
    # Reconciliation may rewrite schedules/ACLs; report changed conservatively.
    print('CHANGED')


if __name__ == '__main__':
    main()
