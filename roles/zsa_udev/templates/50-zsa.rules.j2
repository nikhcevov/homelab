# Managed by Ansible (roles/zsa_udev) — local edits will be overwritten.
# Upstream: ZSA Oryx web flashing / live training udev rules
# (https://github.com/zsa/oryx, docs "This browser cannot talk to your keyboard").
# Rules for Oryx web flashing and live training.
KERNEL=="hidraw*", ATTRS{idVendor}=="16c0", MODE="0664", GROUP="{{ zsa_udev_group }}"
KERNEL=="hidraw*", ATTRS{idVendor}=="3297", MODE="0664", GROUP="{{ zsa_udev_group }}"

# Legacy rules for live training over WebUSB (not needed for firmware v21+).
# Rule for all ZSA keyboards.
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", GROUP="{{ zsa_udev_group }}"
# Rule for the Moonlander.
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", ATTR{idProduct}=="1969", GROUP="{{ zsa_udev_group }}"
# Rule for the Ergodox EZ.
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="1307", GROUP="{{ zsa_udev_group }}"
# Rule for the Planck EZ.
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="6060", GROUP="{{ zsa_udev_group }}"

# Wally flashing rules for the Ergodox EZ.
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", ENV{ID_MM_DEVICE_IGNORE}="1"
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789A]?", ENV{MTP_NO_PROBE}="1"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789ABCD]?", MODE:="0666"
KERNEL=="ttyACM*", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", MODE:="0666"

# Keymapp / Wally flashing rules for the Moonlander and Planck EZ.
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE:="0666", SYMLINK+="stm32_dfu"
# Keymapp flashing rules for the Voyager.
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3297", MODE:="0666", SYMLINK+="ignition_dfu"
