TZ={{ compose_tz }}
COMPOSE_PROJECT_NAME=sure
APP_DOMAIN=budget.{{ vault_caddy_public_domain }}
WEBAUTHN_RP_ID=budget.{{ vault_caddy_public_domain }}
WEBAUTHN_ALLOWED_ORIGINS=https://budget.{{ vault_caddy_public_domain }}
POSTGRES_USER=sure_user
POSTGRES_DB=sure_production
POSTGRES_PASSWORD={{ vault_sure_postgres_password | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
SECRET_KEY_BASE={{ vault_sure_secret_key_base | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={{ vault_sure_active_record_encryption_primary_key | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={{ vault_sure_active_record_encryption_deterministic_key | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={{ vault_sure_active_record_encryption_key_derivation_salt | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
ONBOARDING_STATE={{ sure_onboarding_state | default('open') }}
