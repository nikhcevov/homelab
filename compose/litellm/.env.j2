LITELLM_MASTER_KEY={{ vault_litellm_master_key | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
LITELLM_SALT_KEY={{ vault_litellm_salt_key | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
POSTGRES_PASSWORD={{ vault_litellm_postgres_password | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
DATABASE_URL={{ ('postgresql://litellm:' ~ (vault_litellm_postgres_password | urlencode | replace('/', '%2F')) ~ '@db:5432/litellm') | to_json(ensure_ascii=false) | replace('$', '$$') }}
