global:
  scrape_interval: 60s
  evaluation_interval: 60s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node-pve
    static_configs:
      - targets: ["10.77.0.1:9100"]

  - job_name: node-docker
    static_configs:
      - targets: ["10.77.0.2:9100"]

  - job_name: smartctl-pve
    static_configs:
      - targets: ["10.77.0.1:9633"]

  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
    metric_relabel_configs:
      - source_labels: [container_label_com_docker_compose_service]
        target_label: name
      - source_labels: [container_label_com_docker_compose_project]
        target_label: compose_project
      - target_label: instance
        replacement: docker-1

  - job_name: pve
    metrics_path: /pve
    params:
      target: ["{{ observability_pve_api_target }}"]
      cluster: ["1"]
      node: ["1"]
    static_configs:
      - targets: ["pve-exporter:9221"]
