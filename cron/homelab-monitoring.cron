SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Critical services every 15 min
*/15 * * * * root /opt/homelab-monitoring/scripts/check-services.sh

# Docker containers every 15 min
*/15 * * * * root /opt/homelab-monitoring/scripts/check-containers.sh

# HTTPS endpoints every 15 min
*/15 * * * * root /opt/homelab-monitoring/scripts/check-https.sh

# TCP ports every 15 min
*/15 * * * * root /opt/homelab-monitoring/scripts/check-port.sh

# Disk usage every hour
30 * * * * root /opt/homelab-monitoring/scripts/check-disk.sh

# Updates daily
0 10 * * * root /opt/homelab-monitoring/scripts/check-updates.sh

# Reboot required daily
15 10 * * * root /opt/homelab-monitoring/scripts/check-reboot.sh

# Backup freshness daily
30 10 * * * root /opt/homelab-monitoring/scripts/check-backup.sh
